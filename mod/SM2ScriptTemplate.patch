diff -ru tpl/game/Actor.h ours/game/Actor.h
--- a/game/Actor.h
+++ b/game/Actor.h
@@ -36,6 +36,8 @@
     char _0x12[0x54];
     ComponentEntry* component_list;
     short component_count;
+    // Do not trust this padding to place `name` -- the compiler adds its own
+    // alignment on top. GetName() reads +0xB8 explicitly instead.
     char _0x72[0x38];
     char* name;
 public:
@@ -77,6 +79,22 @@
         return component_count;
     }
 
+    // Added for the capture harness -- the actor name is our best candidate for
+    // an identifier that survives restarts, so every captured instance records it.
+    //
+    // Read at an explicit offset rather than through the `name` member. The
+    // struct's declared padding does not account for the compiler's own
+    // alignment, so adjusting the padding array to reach +0xB8 silently landed
+    // at +0xC0 instead. +0xB8 was derived empirically: sweeping 249 live actors
+    // for string pointers found a real name there on every one, and nowhere else.
+    inline const char* GetName() const {
+        return *reinterpret_cast<char* const*>(reinterpret_cast<const char*>(this) + 0xB8);
+    }
+
+    inline uint32_t GetFlags() const {
+        return flags;
+    }
+
     inline ComponentEntry* GetComponentEntries() {
         return component_list;
     }
diff -ru tpl/game/ActorHandle.h ours/game/ActorHandle.h
--- a/game/ActorHandle.h
+++ b/game/ActorHandle.h
@@ -12,4 +12,15 @@
     }
 
     bool operator==(ActorHandle &other) { return handle == other.handle; }
+
+    // Added for the capture harness. The hook records the packed handle while the
+    // actor is still under construction; resolution happens later, so we need to
+    // rebuild a handle from the raw value to look the finished actor back up.
+    static ActorHandle FromRaw(uint32_t raw) {
+        ActorHandle h;
+        h.handle = raw;
+        return h;
+    }
+
+    uint32_t Raw() const { return handle; }
 };
